#!/bin/sh
# Barra segredos e dados pessoais antes do commit (regras em .gitleaks.toml).
# Ligado por `pnpm install` (script prepare: git config core.hooksPath .githooks).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks não encontrado. Instale com 'brew install gitleaks'." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml || exit 1
